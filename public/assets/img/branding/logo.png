<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 280 70" width="280" height="70" fill="none">
  <defs>
    <linearGradient id="akLogoGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#FF5252"/>
      <stop offset="50%" stop-color="#FF7A00"/>
      <stop offset="100%" stop-color="#FF9E00"/>
    </linearGradient>
    <linearGradient id="akTextGrad" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#1E293B"/>
      <stop offset="100%" stop-color="#0F172A"/>
    </linearGradient>
    <linearGradient id="akStarGradL" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#FFDF00"/>
      <stop offset="100%" stop-color="#FFA500"/>
    </linearGradient>
  </defs>

  <!-- Cute Cartoon Mascot (Left Badge) -->
  <g transform="translate(5, 5)">
    <rect width="60" height="60" rx="18" fill="url(#akLogoGrad)"/>
    <circle cx="30" cy="30" r="25" fill="#FFFFFF" fill-opacity="0.12"/>
    
    <!-- Mascot Group -->
    <g transform="translate(-10, -8) scale(0.6)">
      <!-- Cart Handles -->
      <path d="M22 36 C18 36 16 30 19 25 C22 20 28 24 26 30" stroke="#FFFFFF" stroke-width="5" stroke-linecap="round" fill="none"/>
      <path d="M78 36 C82 36 84 30 81 25 C78 20 72 24 74 30" stroke="#FFFFFF" stroke-width="5" stroke-linecap="round" fill="none"/>

      <!-- Cart Body -->
      <path d="M23 34 H77 C77 34 74 62 68 66 C62 70 38 70 32 66 C26 62 23 34 23 34 Z" fill="#FFFFFF"/>

      <!-- AK Monogram -->
      <path d="M36 58 L42 42 L48 58 M38 52 H46" stroke="#FF5252" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M54 42 V58 M63 42 L55 50 L64 58" stroke="#FF5252" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round"/>

      <!-- Kawaii Eyes -->
      <circle cx="37" cy="32" r="4.5" fill="#1E293B"/>
      <circle cx="35.5" cy="30.5" r="1.8" fill="#FFFFFF"/>
      <circle cx="63" cy="32" r="4.5" fill="#1E293B"/>
      <circle cx="61.5" cy="30.5" r="1.8" fill="#FFFFFF"/>

      <!-- Blush -->
      <ellipse cx="30" cy="36" rx="3.5" ry="2.2" fill="#FF85A1"/>
      <ellipse cx="70" cy="36" rx="3.5" ry="2.2" fill="#FF85A1"/>

      <!-- Smile -->
      <path d="M45 35 Q50 41 55 35" stroke="#1E293B" stroke-width="3.5" stroke-linecap="round" fill="none"/>

      <!-- Wheels -->
      <circle cx="36" cy="74" r="5" fill="#FFFFFF"/>
      <circle cx="36" cy="74" r="2.5" fill="#FF5252"/>
      <circle cx="64" cy="74" r="5" fill="#FFFFFF"/>
      <circle cx="64" cy="74" r="2.5" fill="#FF5252"/>
    </g>

    <!-- Star Sparkle -->
    <path d="M50 10 L51.5 14 L55 15.5 L51.5 17 L50 21 L48.5 17 L45 15.5 L48.5 14 Z" fill="url(#akStarGradL)"/>
  </g>

  <!-- Typography: AK-Mart -->
  <text x="78" y="44" font-family="'Outfit', 'Plus Jakarta Sans', 'Segoe UI', sans-serif" font-weight="800" font-size="30" fill="url(#akTextGrad)" letter-spacing="-0.5">
    AK<tspan fill="#FF5252">-Mart</tspan>
  </text>
  
  <!-- Cute Tagline Badge -->
  <rect x="78" y="49" width="105" height="15" rx="7.5" fill="#FF7A00" fill-opacity="0.1"/>
  <text x="83" y="60" font-family="'Outfit', 'Segoe UI', sans-serif" font-weight="700" font-size="9" fill="#FF5252" letter-spacing="0.6">
    SMART MINI-MART
  </text>

  <!-- Cute Accent Heart Dot -->
  <circle cx="218" cy="24" r="3.5" fill="#FF5252"/>
</svg>
