<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" width="64" height="64" fill="none">
  <defs>
    <linearGradient id="akFavGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#FF5252"/>
      <stop offset="50%" stop-color="#FF7A00"/>
      <stop offset="100%" stop-color="#FF9E00"/>
    </linearGradient>
  </defs>

  <rect width="64" height="64" rx="18" fill="url(#akFavGrad)"/>
  
  <g transform="translate(-18, -18) scale(1.36)">
    <!-- Cart Handles -->
    <path d="M22 36 C18 36 16 30 19 25 C22 20 28 24 26 30" stroke="#FFFFFF" stroke-width="4" stroke-linecap="round" fill="none"/>
    <path d="M78 36 C82 36 84 30 81 25 C78 20 72 24 74 30" stroke="#FFFFFF" stroke-width="4" stroke-linecap="round" fill="none"/>

    <!-- Cart Body -->
    <path d="M23 34 H77 C77 34 74 62 68 66 C62 70 38 70 32 66 C26 62 23 34 23 34 Z" fill="#FFFFFF"/>

    <!-- AK Monogram -->
    <path d="M36 58 L42 42 L48 58 M38 52 H46" stroke="#FF5252" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"/>
    <path d="M54 42 V58 M63 42 L55 50 L64 58" stroke="#FF5252" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"/>

    <!-- Kawaii Eyes -->
    <circle cx="37" cy="32" r="3.5" fill="#1E293B"/>
    <circle cx="36" cy="31" r="1.2" fill="#FFFFFF"/>
    <circle cx="63" cy="32" r="3.5" fill="#1E293B"/>
    <circle cx="62" cy="31" r="1.2" fill="#FFFFFF"/>

    <!-- Blush -->
    <ellipse cx="30" cy="35" rx="3" ry="1.8" fill="#FF85A1"/>
    <ellipse cx="70" cy="35" rx="3" ry="1.8" fill="#FF85A1"/>

    <!-- Smile -->
    <path d="M45 35 Q50 40 55 35" stroke="#1E293B" stroke-width="2.5" stroke-linecap="round" fill="none"/>

    <!-- Wheels -->
    <circle cx="36" cy="74" r="4" fill="#FFFFFF"/>
    <circle cx="36" cy="74" r="2" fill="#FF5252"/>
    <circle cx="64" cy="74" r="4" fill="#FFFFFF"/>
    <circle cx="64" cy="74" r="2" fill="#FF5252"/>
  </g>
</svg>
